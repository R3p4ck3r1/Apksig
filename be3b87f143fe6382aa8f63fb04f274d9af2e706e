    {
      "key": {
        "uuid": "236021d3_4a25c032",
        "filename": "src/main/java/com/android/apksig/ApkSigner.java",
        "patchSetId": 2
      },
      "lineNbr": 841,
      "author": {
        "id": 1026058
      },
      "writtenOn": "2018-01-16T19:03:21Z",
      "side": 1,
      "message": "They are used in the v3 specification to allow for multiple v3 signatures, which target different platform versions (this is to allow rotating to a new key algorithm supported by a future platform version).  There are some TODO\u0027s for that functionality, so right now they don\u0027t do anything.",
      "parentUuid": "0f60a3e0_fc4596f2",
      "revId": "be3b87f143fe6382aa8f63fb04f274d9af2e706e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
